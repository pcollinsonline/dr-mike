{
  "name": "dr-mike",
  "version": "0.4.0",
  "description": "Opinionated, composable ESLint, TypeScript, and Vitest configuration presets",
  "keywords": [
    "eslint",
    "eslint-config",
    "tsconfig",
    "typescript",
    "vitest",
    "config"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcollinsonline/dr-mike.git"
  },
  "bugs": {
    "url": "https://github.com/pcollinsonline/dr-mike/issues"
  },
  "homepage": "https://github.com/pcollinsonline/dr-mike#readme",
  "exports": {
    "./eslint": "./eslint/node.js",
    "./eslint/full": "./eslint/full.js",
    "./eslint/svelte": "./eslint/svelte.js",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./tsconfig/node-effect": "./tsconfig/node-effect.json",
    "./tsconfig/svelte": "./tsconfig/svelte.json",
    "./vitest": {
      "types": "./vitest/types.d.ts",
      "default": "./vitest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "eslint",
    "tsconfig",
    "vitest"
  ],
  "scripts": {
    "changeset": "changeset",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@codeforbreakfast/eslint-effect": "0.8.5",
    "@effect/language-service": "0.87.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prefer-arrow": "^1.2.0",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-turbo": "2.11.10",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.6.6"
  }
}
